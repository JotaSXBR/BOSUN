# Local: copie para .env.local e preencha. Nunca commite valores reais.
# Next, worker, Prisma e `pnpm services:up` leem só o .env.local.
# Credenciais do Coolify e valores manuais do deploy ficam no .env.coolify, que nada do app lê.
# Na VPS o Coolify gera a maioria destes valores; o que for manual será indicado no deploy.
# Gere segredos com: openssl rand -hex 32 (só caracteres seguros para a URL abaixo).
POSTGRES_PASSWORD=
# Repita a mesma senha aqui; o arquivo não interpola variáveis.
DATABASE_URL=postgresql://bosun:SENHA@localhost:5432/bosun
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
WAHA_API_KEY=
