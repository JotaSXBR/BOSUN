# Local: copie para .env (ou .env.local, que tem prioridade). Nunca commite valores reais.
# Na VPS o Coolify gera a maioria destes valores; o que for manual será indicado no deploy.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://bosun:<POSTGRES_PASSWORD>@localhost:5432/bosun
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
WAHA_API_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
