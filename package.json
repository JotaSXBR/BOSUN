{
  "name": "bosun",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "concurrently -n web,worker \"next dev\" \"node --env-file=.env --watch worker/index.ts\"",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "worker": "node --env-file=.env worker/index.ts",
    "db:migrate": "prisma migrate dev && node --env-file=.env worker/migrate.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "prisma": "7.10.1",
    "typescript": "7.0.2"
  },
  "type": "module"
}
